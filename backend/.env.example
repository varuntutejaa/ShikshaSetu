# Copy this file to .env and fill in real values before setting MOCK_MODE=false.
# Never commit the real .env file.

# --- General ---
ENVIRONMENT=development

# When true, every AI call (STT/translation/TTS/LLM) returns deterministic
# mock data — the whole app runs with zero API credits spent.
MOCK_MODE=true

# --- Sarvam AI (https://dashboard.sarvam.ai) ---
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai

# --- LLM provider abstraction ---
# One of: mock | openai | sarvam
LLM_PROVIDER=mock
LLM_API_KEY=

# --- LiveKit (teacher video pipeline) ---
# Get these from a LiveKit Cloud project (https://cloud.livekit.io) or a
# self-hosted LiveKit server. Independent of MOCK_MODE — leave empty and the
# Live Class screen shows "Video not configured" while AI audio translation
# keeps working normally over its own WebSocket.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Database: Supabase PostgreSQL ---
# Server-side only. Use Supabase's connection string and keep credentials out
# of Next.js/browser/Android builds. SQLAlchemy asyncpg requires the
# postgresql+asyncpg scheme.
# Example direct/session-pooler format:
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<db-password>@<supabase-host>:5432/postgres?ssl=require

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000

# --- Student auth ---
# Required as the X-Admin-Key header to create student logins via
# POST /api/auth/student/register. Empty (default) leaves it open — fine for
# local/demo use; set this before exposing the backend publicly.
ADMIN_API_KEY=
